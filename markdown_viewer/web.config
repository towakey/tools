<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS で .md ファイルを配信できるようにするMIMEマップ定義。
     既存の web.config がある環境では <mimeMap> 行だけを既存側にマージしてください。 -->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
    </staticContent>
  </system.webServer>
</configuration>
